# PostgreSQL connection string for the shared leaderboard.
# Unset in local dev → an embedded PGlite database is created in .pglite/ automatically.
# Required in production (e.g. Neon via the Vercel Marketplace, Supabase, or any Postgres).
DATABASE_URL=

# Salt for hashing player IP addresses used in rate limits (any long random string).
IP_HASH_SALT=
